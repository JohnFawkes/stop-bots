# NGINX with ModSecurity and the OWASP Core Rule Set, as Ubuntu packages
# them, for the ModSecurity tests: the same idea as `Dockerfile`, with the
# module and CRS installed and nothing of them configured, which is what
# stop-bots does.
#
# Two sites: test.example on 8080, static; and photos.example on 8081,
# which passes to Immich's default port, 2283, where a third server stands
# in for Immich, so the site is recognised as one.
FROM ubuntu:24.04

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        nginx libnginx-mod-http-modsecurity modsecurity-crs curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/www/test && echo '<h1>hello</h1>' > /var/www/test/index.html && \
    rm -f /etc/nginx/sites-enabled/default && \
    printf '%s\n' \
        'server {' \
        '    listen 8080;' \
        '    server_name test.example;' \
        '    root /var/www/test;' \
        '    index index.html;' \
        '}' > /etc/nginx/sites-enabled/test-site.conf && \
    printf '%s\n' \
        'server {' \
        '    listen 8081;' \
        '    server_name photos.example;' \
        '    location / {' \
        '        proxy_pass http://127.0.0.1:2283;' \
        '    }' \
        '}' > /etc/nginx/sites-enabled/photos.conf && \
    printf '%s\n' \
        'server {' \
        '    listen 127.0.0.1:2283;' \
        '    location / {' \
        '        return 200 "immich\n";' \
        '    }' \
        '}' > /etc/nginx/conf.d/immich-stand-in.conf

COPY stop-bots /usr/local/bin/stop-bots

CMD ["sleep", "infinity"]
