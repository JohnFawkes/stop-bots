pkgbase = stop-bots
	pkgdesc = A TUI and CLI that help you configure NGINX, Apache or Traefik and your firewall to stop bad bots and still allow good bots
	pkgver = 0.9.0
	pkgrel = 1
	url = https://github.com/ivankovic/stop-bots
	arch = x86_64
	license = AGPL-3.0-only
	makedepends = cargo
	depends = gcc-libs
	optdepends = nginx: to apply the generated site blocking rules
	optdepends = apache: to apply the generated site blocking rules, instead of nginx
	optdepends = traefik: to apply the generated blocking routers, instead of nginx
	optdepends = nftables: to apply the generated firewall script
	optdepends = iptables: alternative firewall backend
	options = !lto
	source = stop-bots-0.9.0.tar.gz::https://static.crates.io/crates/stop-bots/stop-bots-0.9.0.crate
	sha256sums = ccdf2b5cc9bf8faa37c303691ac778bbf877b988f5cc2082890cb978d061821f

pkgname = stop-bots
