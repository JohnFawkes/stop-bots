pkgbase = stop-bots
	pkgdesc = A TUI and CLI that help you configure NGINX or Apache and your firewall to stop bad bots and still allow good bots
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/ivankovic/stop-bots
	arch = x86_64
	license = AGPL-3.0-only
	makedepends = cargo
	depends = gcc-libs
	optdepends = nginx: to apply the generated site blocking rules
	optdepends = apache: to apply the generated site blocking rules, instead of nginx
	optdepends = nftables: to apply the generated firewall script
	optdepends = iptables: alternative firewall backend
	options = !lto
	source = stop-bots-0.2.0.tar.gz::https://static.crates.io/crates/stop-bots/stop-bots-0.2.0.crate
	sha256sums = 3e28dd2a224b04e1fff18defe28f4e344d95d6c7db51a9cc6b44c9325825651a

pkgname = stop-bots
